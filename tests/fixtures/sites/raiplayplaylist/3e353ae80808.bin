", "details": [{"type": "label", "key": "program_name", "value": "Non dirlo al mio capo"}, {"type": "label", "key": "year", "value": "2018"}, {"type": "label", "key": "season", "value": "St 2"}, {"type": "label", "key": "episode", "value": "Ep 1"}, {"type": "icon", "key": "subtitles", "value": true}, {"type": "label", "key": "duration_in_minutes", "value": "55 min"}, {"type": "placeholder", "key": "availability"}]}, {"id": "ContentItem-8df4c050-09e3-40fc-a9c4-b075b53c6082", "path_id": "/video/2018/09/Non-dirlo-al-mio-capo-S2E2---Il-tre-non-e-il-numero-perfetto-8df4c050-09e3-40fc-a9c4-b075b53c6082.json", "rights_management": {"rights": {"offline": {}, "drm": {}, "geoprotection": {"Fuori dall'Europa": true, "Fuori dall'Italia": true}}}, "availabilities": null, "images": {"landscape": "/dl/img/2018/09/12/1536763780995_vlcsnap-2018-09-12-16h52m48s545.png", "portrait": "", "square": "", "landscape43": "", "portrait43": "", "portrait_logo": "", "landscape_logo": "", "program_landscape": ""}, "color": {"hex": "#202132", "rgba": [32, 33, 50, 1]}, "type": "RaiPlay Video Item", "forma": "Integrale", "info_url": "/video/info/8df4c050-09e3-40fc-a9c4-b075b53c6082.json", "video_url": "https://mediapolisvod.rai.it/relinker/relinkerServlet.htm?cont=YMxlOEpKb5ceeqqEEqual", "is_live": false, "weblink": "/video/2018/09/Non-dirlo-al-mio-capo-S2E2---Il-tre-non-e-il-numero-perfetto-8df4c050-09e3-40fc-a9c4-b075b53c6082.html", "toptitle": "Il tre non \u00e8 il numero perfetto", "subtitle": "St 2 Ep 2 - Non dirlo al mio capo", "aria_label": "Stagione 2 - Episodio 2 - Il tre non \u00e8 il numero perfetto  - Non dirlo al mio capo", "name": "Non dirlo al mio capo S2E2 - Il tre non \u00e8 il numero perfetto", "program_name": "Non dirlo al mio capo", "login_required": true, "duration_in_minutes": "51 min", "duration": "00:51:17", "season": "2", "episode": "2", "episode_title": "Il tre non \u00e8 il numero perfetto", "program_url": "/programmi/nondirloalmiocapo", "program_path_id": "/programmi/nondirloalmiocapo.json", "label": "", "description": "Per un imprevisto Lisa non riesce a sostenere l'esame per l'abilitazione e si trova costretta a mentire di nuovo al suo capo. Nel frattempo, Enrico, dapprima deciso a chiedere il divorzio da Nina, lavorando con la sua ex-moglie, finisce per riavvicinarsi a lei. Perla cerca in tutti i modi di dimostrare di essere a suo agio nel ruolo di segretaria dello studio e tata di Giuseppe e Mia.", "vanity": "", "country": "", "details": [{"type": "label", "key": "program_name", "value": "Non dirlo al mio capo"}, {"type": "label", "key": "year", "value": "2018"}, {"type": "label", "key": "season", "value": "St 2"}, {"type": "label", "key": "episode", "value": "Ep 2"}, {"type": "icon", "key": "subtitles", "value": true}, {"type": "label", "key": "duration_in_minutes", "value": "51 min"}, {"type": "placeholder", "key": "availability"}]}], "track_info": {"id": "ContentSet-262062be-168b-49e5-aeeb-da740df7e5d1", "domain": "raiplay", "platform": "[platform]", "media_type": "", "page_type": "", "editor": "raiplay", "year": "", "edit_year": "", "section": "sezione programma episodi", "sub_section": "sottosezione programma stagione 2", "content": "", "title": "", "channel": "", "channel_auditel": "", "date": "", "publication_date": "", "emission_date": "", "update_date": "", "typology": "fiction", "genres": [], "sub_genres": [], "program_title": "non dirlo al mio capo", "program_typology": "scheda-programma-sottosezione", "program_genres": ["sentimentale", "commedia", "fiction italiana"], "program_sub_genres": ["commedia all'italiana", "comico", "romantico", "storie comuni"], "edition": "", "season": "", "episode_number": "", "episode_title": "", "form": "", "listaDateMo": [], "page_url": "", "nodmp": false, "dfp": {}, "origin": "", "target": ""}}