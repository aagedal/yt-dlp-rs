p4/static/clear/5530036772001/1bbc44f6-c63c-4981-82fa-46b0c1f891e0/4dd0f531-71f8-4995-b61d-a4f07b68adb6/main.mp4?fastly_","width":1280},{"avg_bitrate":2682000,"codec":"H264","container":"MP4","duration":350165,"height":720,"size":117561097,"src":"https://fastly-signed-us-east-1-prod.brightcovecdn.com/media/v1/pmp4/static/clear/5530036772001/1bbc44f6-c63c-4981-82fa-46b0c1f891e0/4dd0f531-71f8-4995-b61d-a4f07b68adb6/main.mp4?fastly_","width":1280}],"video_preview":[{"ext_x_version":"7","src":"http://manifest.prod.boltdns.net/manifest/v2/hls/v7/clear/5530036772001/1bbc44f6-c63c-4981-82fa-46b0c1f891e0/10s/preview.m3u8?fastly_token=NmNjNGRmMDRfODJlMzZkNjE1MDM1YTM3MTFiMDRlODA1NDY5YzE5NzgzZTZiN2E0ZGMyOTlkMjk4ZTc4OTk5NGNjNzY3YzhkZg%3D%3D","type":"application/x-mpegURL"},{"ext_x_version":"7","src":"https://manifest.prod.boltdns.net/manifest/v2/hls/v7/clear/5530036772001/1bbc44f6-c63c-4981-82fa-46b0c1f891e0/10s/preview.m3u8?fastly_token=NmNjNGRmMDRfODJlMzZkNjE1MDM1YTM3MTFiMDRlODA1NDY5YzE5NzgzZTZiN2E0ZGMyOTlkMjk4ZTc4OTk5NGNjNzY3YzhkZg%3D%3D","type":"application/x-mpegURL"}],"name":"Can Alphonso Davies lead Canada to its first World Cup since 1986? ","reference_id":null,"long_description":"Is this a new chapter for Canadian Soccer?  Led by coach, John Herdman, and the likes of Alphonso Davies, Cyle Larin, Tajon Buchanan and others, there is an optimistic buzz around Canadian Soccer that hasn't been around since they last qualified for the World Cup in 1986. However, this talented group doesn't seem satisfied with just being a contender -- with world class players domestically and abroad, this team seeks to write their own history, with Canada at the top of CONCACAF and back in the World Cup.  Hear from MLS and National Team legends Dwayne De Rosario, Patrice Bernier, and others about this young and exciting group, and why Mexico, the United States, and the rest of CONCACAF need to be on high alert when facing Canada.  \"The Octagon\" is a new series that explores the most unique stories around CONCACAF World Cup Qualifying, focusing it mostly on USA, Mexico, and Canada, and illustrating the aspects that make it unlike an soccer region in the world.  Footage Courtesy: Canada Soccer Footage Courtesy: \"U.S. Soccer / Veritone\" Footage Courtesy: Paramount + / CBS Sports","duration":350165,"economics":"AD_SUPPORTED","text_tracks":[{"id":null,"account_id":"5530036772001","src":"http://manifest.prod.boltdns.net/thumbnail/v1/5530036772001/1bbc44f6-c63c-4981-82fa-46b0c1f891e0/low-res/thumbnail.webvtt?fastly_token=NmNjNGRmMDRfYmIxMjAxZmUyZTdlNTFjN2JjNTI1Yjg2YzUzMDg3ODZkMjk3ZTNiZmRhYjljNDc3ZjY4OTAyNWYzZTQ3ZWE3ZA%3D%3D","srclang":null,"label":"thumbnails","kind":"metadata","mime_type":"text/webvtt","asset_id":null,"sources":null,"default":false,"width":480,"height":270},{"id":null,"account_id":"5530036772001","src":"https://manifest.prod.boltdns.net/thumbnail/v1/5530036772001/1bbc44f6-c63c-4981-82fa-46b0c1f891e0/low-res/thumbnail.webvtt?fastly_token=NmNjNGRmMDRfYmIxMjAxZmUyZTdlNTFjN2JjNTI1Yjg2YzUzMDg3ODZkMjk3ZTNiZmRhYjljNDc3ZjY4OTAyNWYzZTQ3ZWE3ZA%3D%3D","srclang":null,"label":"thumbnails","kind":"metadata","mime_type":"text/webvtt","asset_id":null,"sources":null,"default":false,"width":480,"height":270}],"published_at":"2021-10-07T17:21:31.382Z","created_at":"2021-10-07T17:21:31.370Z","updated_at":"2023-07-04T13:24:33.387Z","offline_enabled":false,"link":null,"id":"6276033198001","ad_keys":null}
