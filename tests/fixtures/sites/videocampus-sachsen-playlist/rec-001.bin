<script type="text/javascript">


var mediaBoxListPagerNormal = function() 
{
  jQuery("#").one('click', ".pagingLinks ul.pagination li a", function(e) 
  {
    var filterData = $("#").data("box-list");
    
    var data = { vars: filterData };
    
    if('' === 'newMediaList') // Work-Around so the search for the add media modal can work with the pager
    {
      data.search = jQuery('[name="manageMediaSearch"]').val();
    }
    
    jQuery.ajax(
    {
      type: "POST", 
      url: "/media/ajax/component/boxList/page_only/1/category/online-tutorials-onyx/category_id/91?page="+$(this).data("page"),
      data: data,
      beforeSend: function(xhr, settings) 
      {
         jQuery("#").append("<div class=\"loadingOverlay\"><span class=\"loader-wrapper\"><span class=\"loader-icon-main\"></span></span></div>");
      },
      complete: function(xhr, status) 
      {
        response = xhr.responseText;
        jQuery("#").empty().append(response);
        if(jQuery("#").data("box-list")?.mod == "album" && jQuery("#").data("box-list").act == "manageMedia")
        {
          albumSortable();
        }
       if(jQuery("#").data("box-list")?.mod == "channels" && jQuery("#").data("box-list").act == "manageMedia")
       {
         channelSortable();
       }
        
      },
      success: function(data, status, xhr) 
      {
        response = data; 
        jQuery("# button.loading").remove(); 
      } 
    });
  }); 
}
if(document.readyState === 'complete')
{
  if(typeof alreadyCalledMediaBoxListPagerNormal === 'undefined')
  {
    alreadyCalledMediaBoxListPagerNormal = false;
  }
  
  if(!alreadyCalledMediaBoxListPagerNormal)
  {
    alreadyCalledMediaBoxListPagerNormal = true;
    mediaBoxListPagerNormal();      
  }
}</script>
