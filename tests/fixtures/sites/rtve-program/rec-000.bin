<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "TVSeries",
        "name": "Saber vivir",
        "url": "https://www.rtve.es/play/videos/saber-vivir/",
        "description": "Saber Vivir es el programa decano de TVE dedicado a la salud, el bienestar y la calidad de vida. Cumpliendo un servicio público de calidad, el magazine busca informar, formar y entretener a toda la familia mediante la divulgación de consejos útiles y prácticos para vivir más y mejor. Dichos consejos son ofrecidos siempre por profesionales sanitarios de todos los ámbitos: medicina, enfermería, nutrición, farmacia, psicología, fisioterapia y actividad física. Todas las recomendaciones están basadas en la evidencia científica y la experiencia clínica de los especialistas que acuden al programa como colaboradores o invitados en cada emisión, con la intervención de Sergio Fernández, el chef de TVE, como profesor de cocina casera y saludable. ",
        "image": "https://img.rtve.es/p/111570/",
        "genre": "Ciencia y futuro",
        "inLanguage": "es",
        "producer": [
          { "@type": "Person", "name": "Ana Martín." },
            { "@type": "Person", "name": "Patricia Ituarte" }],
        "director": [
          { "@type": "Person", "name": "Alfonso García" },
            { "@type": "Person", "name": "Jero Fernández" }]
    }
</script>
