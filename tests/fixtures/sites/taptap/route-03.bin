{"data":{"id":168332,"identifier":"com.miHoYo.Yuanshen","itunes_id":"1467190251","title":"原神","title_labels":[],"icon":{"url":"https://img-tc.tapimg.com/market/images/c1c3536428a8dfb044a12bff3614a993.png/_tap_appicon.jpg","medium_url":"https://img-tc.tapimg.com/market/images/c1c3536428a8dfb044a12bff3614a993.png/_tap_appicon_m.jpg","small_url":"https://img-tc.tapimg.com/market/images/c1c3536428a8dfb044a12bff3614a993.png/_tap_appicon_s.jpg","original_url":"https://img-tc.tapimg.com/market/images/c1c3536428a8dfb044a12bff3614a993.png","original_format":"png","width":270,"height":270,"color":"0x997543","original_size":210377,"large_url":"https://img-tc.tapimg.com/market/images/c1c3536428a8dfb044a12bff3614a993.png/_tap_appicon.jpg"},"style":0,"update_time":1790114401,"hidden_button":false,"has_moment_rec":true,"is_deny_minors":false,"is_exclusive":false,"app_videos":[{"type":"app_detail","id":5896874,"thumbnail":{"url":"https://img-tc.tapimg.com/market/images/3967c434aeaa96b7cc106740971ac4a3.jpg/_tap_banner.jpg","medium_url":"https://img-tc.tapimg.com/market/images/3967c434aeaa96b7cc106740971ac4a3.jpg/_tap_banner_m.jpg","small_url":"https://img-tc.tapimg.com/market/images/3967c434aeaa96b7cc106740971ac4a3.jpg/_tap_banner_s.jpg","original_url":"https://img-tc.tapimg.com/market/images/3967c434aeaa96b7cc106740971ac4a3.jpg","original_format":"jpeg","width":1920,"height":1080,"color":"0x73282f","original_size":777887,"large_url":"https://img-tc.tapimg.com/market/images/3967c434aeaa96b7cc106740971ac4a3.jpg/_tap_banner_l.jpg"},"aspect_ratio":1.7777777777777777},{"type":"app_trial","id":4058443,"thumbnail":{"url":"https://img-tc.tapimg.com/market/images/3967c434aeaa96b7cc106740971ac4a3.jpg/_tap_banner.jpg","medium_url":"https://img-tc.tapimg.com/market/images/3967c434aeaa96b7cc106740971ac4a3.jpg/_tap_banner_m.jpg","small_url":"https://img-tc.tapimg.com/market/images/3967c434aeaa96b7cc106740971ac4a3.jpg/_tap_banner_s.jpg","original_url":"https://img-tc.tapimg.com/market/images/3967