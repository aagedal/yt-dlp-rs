  if (!thumb) {
    if (/\/dl\/RaiTV\/dirette\//.test(document.location)) {
      thumb = $('.boxDiretta>.top>h2').css('backgroundImage') || 'url()';
      thumb = thumb.replace(/.*url\((.*)\).*/, '$1');
    }
  }
  if (!!thumb) {
    if (/^\/dl\//.test(thumb)) {
      thumb = 'http://www.rai.tv'+thumb;
    }
    thumb = '<imgurl>'+thumb+'</imgurl>';
  }

  if (rightTitle != '') {
    var isPreroll = false;
    for (var i = 0; i< arguments.length; i++) {
