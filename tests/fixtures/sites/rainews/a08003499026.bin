      var box, btnVideo, btnFoto, tabVideo, tabFoto;
      box = $(this);
      btnVideo = box.find('a.video');
      btnFoto = box.find('a.foto');
      tabVideo = box.find('.tabVideo');
      tabFoto = box.find('.tabFoto');
      btnVideo.click(function() {
