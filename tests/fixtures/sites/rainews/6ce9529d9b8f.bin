hide">Seguici su twitter</span> </a> </li> <li class="social__list__item" role="none"> <a href="https://www.instagram.com/rainewsofficial/?hl&#x3D;it" aria-label="Seguici su instagram" target="_blank" class="link link--instagram" rel="me" role="menuitem">  <span class="hide">Seguici su instagram</span> </a> </li> <li class="social__list__item" role="none"> <a href="/rss" aria-label="Feed rss" target="_blank" class="link link--rss" role="menuitem">  </a> </li> </ul> </div> </div> </rainews-menu> <div class="mask-overlay"></div> </div> </rainews-header> </header> <main> <section class="leaf leaf--multimedia type-video"> <div class="article-wrapper"> <article class="article"> <header class="article__header duplicated-breadcrumb"> <div class="grid-x article__preheader"> <div class="cell small-12"> <span class="article__label"> <a class="ancestor" href="/esteri" title="Esteri">Esteri</a> <a class="maintheme" href="/archivio/esteri/guerreeconflitti" title="Guerre e conflitti">Guerre e conflitti</a> </span> </div> </div> </header> <div class="grid-x"> <div class="cell large-8 sidegutterright"> <div class="article__media-container fullmedium"> <div class="article__media-wrapper article__media-wrapper--player normal-wrapper" data-nosnippet> <div class="loader"></div> <rainews-player data='{&quot;masterRoleCategoryUniqueName&quot;:&quot;Category-60bbaf3f-99b8-4aac-8a6d-69a98e11bfc1&quot;,&quot;real_type&quot;:&quot;RaiNews Video Item&quot;,&quot;title&quot;:&quot;Il dolore, la sofferenza: abitanti di un villaggio di Kharkiv lasciano le loro case: il video&quot;,&quot;summary&quot;:&quot;Funzionari della Croce Rossa hanno aiutato i residenti ad evacuare dal villaggio di Vilkhuvatka, nella regione di Kharkiv&quot;,&quot;image&quot;:&quot;/cropgd/806x453/dl/img/2024/02/25/1708853131583_Immagine__.png&quot;,&quot;adv&quot;:{&quot;nobanner&quot;:false,&quot;adv_label&quot;:null,&quot;nofloorad&quot;:false,&quot;tema1&quot;:&quot;Esteri&quot;,&quot;tema2&quot;:&quot;Guerreeconflitti&quot;,&quot;isVideoEmbedded&quot;:true},&quot;mediapolis&quot;:&quot;http://mediapolisvod.rai.it/relinker/relinkerServlet.htm?cont&#x3D;YeV73EnfJHgcRFHt1PCeOgeeqqEEqualeeqqEEqual&quot;,&quot;live&quot;:false,&quot;audio&quot;:false,&quot;stream_type&quot;:&quot;&quot;,&quot;autoplay&quot;:true,&quot;pip&quot;:true,&quot;content_url&quot;:&quot;http://mediapolisvod.rai.it/relinker/relinkerServlet.htm?cont&#x3D;YeV73EnfJHgcRFHt1PCeOgeeqqEEqualeeqqEEqual&quot;,&quot;weblink&quot;:&quot;/video/2024/02/membri-della-croce-rossa-evacuano-gli-abitanti-di-un-villaggio-nella-regione-ucraina-di-kharkiv-il-filmato-dallucraina--31e8017c-845c-43f5-9c48-245b43c3a079.html&quot;,&quot;subtitles&quot;:&quot;&quot;,&quot;dash&quot;:&quot;&quot;,&quot;uhd&quot;:&quot;&quot;,&quot;track_info&quot;:{&quot;id&quot;:&quot;ContentItem-31e8017c-845c-43f5-9c48-245b43c3a079&quot;,&quot;domain&quot;:&quot;rainews&quot;,&quot;media_type&quot;:&quot;vod&quot;,&quot;page_type&quot;:&quot;video&quot;,&quot;editor&quot;:&quot;rainews&quot;,&quot;section&quot;:&quot;video&quot;,&quot;sub_section&quot;:null,&quot;content&quot;:&quot;pagina video&quot;,&quot;title&quot;:&quot;Il dolore, la sofferenza: abitanti di un villaggio di Kharkiv lasciano le loro case: il video&quot;,&quot;channel&quot;:&quot;rainews digital&quot;,&quot;create_date&quot;:&quot;2024-02-25&quot;,&quot;date&quot;:&quot;2024-02-25&quot;,&quot;typology&quot;:&quot;informazione&quot;,&quot;genres&quot;:[&quot;esteri|guerreeconflitti&quot;],&quot;sub_genres&quot;:[&quot;evacuazione residenti ucraini,evacuazione,Kharkiv,Ucraina,Vilkhuvatka,Membri della Croce Rossa&quot;],&quot;program_title&quot;:&quot;rainews&quot;,&quot;season&quot;:&quot;2024&quot;,&quot;episode_title&quot;:&quot;Il dolore, la sofferenza: abitanti di un villaggio di Kharkiv lasciano le loro case: il video&quot;,&quot;form&quot;:&quot;integrale&quot;,&quot;dfp&quot;:&quot;{\&quot;escaped_name\&quot;:\&quot;guerreeconflitti\&quot;}&quot;}}'></rainews-player> </div> </div> <div class="grid-x"> <div class="cell small-12"> <div class="article__content"> <header class="article__header"> <div class="grid-x article__preheader"> <div class="cell small-12"> <span class="article__label"> <a class="ancestor" href="/esteri" title="Esteri">Esteri</a> <a class="maintheme" href="/archivio/esteri/guerreeconflitti" title="Guerre e conflitti">Guerre e conflitti</a> </span> </div> </div> <div class="article__subheading">Il filmato dall&#x27;Ucraina </div> <h1 class="article__title">Il dolore, la sofferenza: abitanti di un villaggio di Kharkiv lasciano le loro case: il video</h1> <div class="article__subtitle"><p>Funzionari della Croce Rossa hanno aiutato i residenti ad evacuare dal villaggio di Vilkhuvatka, nella regione di Kharkiv</p></div> <div class="article__date-author"> <rainews-date-transform dateiso="2024-02-25T09:28:00+0000"> <div class="article__date"> <i class="icon-2024-calendar"></i> <time datetime="2024-02-25T09:28:00+0000">25/02/2024</time> </div> </rainews-date-transform> <div class="article__author"><strong>Reuters</strong></div> </div> </header> <div class="grid-x"> <div class="cell small-12 medium-1 large-2 text-center"> <div class="buttons-wrapper"> <rainews-sharing data='{ "fbAppId": "742572229276269" }'></rainews-sharing> </div> </div> <div class="cell small-12 medium-11 large-10"> <div class="article__content__unit article__content__unit--text"> <p>Il villaggio è stato teatro di intensi combattimenti nel secondo anniversario della guerra tra Russia e Ucraina. La Russia ha lanciato la sua “operazione militare speciale” in Ucraina esattamente due anni fa, il 24 febbraio 2022.<br>I funzionari russi si sono detti pronti ad avviare i colloqui di pace con l'Ucraina, ma l'auto-divieto di Kiev ai contatti con Mosca ne ha impedito l'inizio.</p><p><a target="_blank" rel="noopener noreferrer" href="https://www.rainews.it/articoli/2024/02/ucraina-2-anni-dopo-e-la-prima-guerra-dei-droni-come-e-cambiato-il-conflitto-il-punto-militare-1648a9a3-7b4a-4bd4-9444-48d5b55c6f7f.html">Ucraina 2 anni dopo: è la prima "guerra dei droni". Come è cambiato il conflitto</a></p><p>Membri della Croce Rossa evacuano gli abitanti di un villaggio nella regione ucraina di Kharkiv: il video dal fronte</p> </div> </div> </div> </div> <div class="tag-container"> <ul class="tag__list"> <li class="tag__list__item"><a href="/tag?evacuazione%20residenti%20ucraini%7CTag-55b12c74-bef6-40da-9a72-334ae54bff9a" class="link">evacuazione residenti ucraini</a></li> <li class="tag__list__item"><a href="/tag?evacuazione%7CTag-eda4f8a0-038e-4bb6-a18f-c8a0e1b44a3b" class="link">evacuazione</a></li> <li class="tag__list__item"><a href="/tag?Kharkiv%7CTag-65c56ab6-f045-44cc-8fd9-6a93987cbe9c" class="link">Kharkiv</a></li> <li class="tag__list__item"><a href="/tag?Ucraina%7CTag-e6d8c49f-97e6-4446-b685-9d06370a9dc7" class="link">Ucraina</a></li> <li class="tag__list__item"><a href="/tag?Vilkhuvatka%7CTag-86ef5691-8dbf-4a59-8a20-787e0d3e5b34" class="link">Vilkhuvatka</a></li> <li class="tag__list__item"><a href="/tag?Membri%20della%20Croce%20Rossa%7CTag-0905f0c0-2ece-4573-bbfc-0c823fa07773" class="link">Membri della Croce Rossa</a></li> </ul> </div> </div> </div> </div> <div class="cell large-4 article__right-column sidegutterleft"> <aside class="aside"> <div class="grid-x"> <div class="cell greycell"> <div class="aside-box aside-box--insights"> <h3 class="aside__title">Leggi anche:</h3> <ul class="aside__list"> <li class="aside__list__item"> <a class="insights-link" href="/articoli/2024/02/ucraina-2-anni-dopo-e-la-prima-guerra-dei-droni-come-e-cambiato-il-conflitto-il-punto-militare-1648a9a3-7b4a-4bd4-9444-48d5b55c6f7f.html"> Ucraina 2 anni dopo: è la prima "guerra dei droni" </a> </li> </ul> </div> </div> </div> </aside> </div> </div> </article> </div> <rainews-strip-related params="{&quot;uniquename&quot;:&quot;ContentItem-31e8017c-845c-43f5-9c48-245b43c3a079&quot;,&quot;themes&quot;:[],&quot;domain_category&quot;:&quot;RaiNews|Category-6