  {
   "guid": "nu_IEETazySR5xcJobNckw",
   "title": "Hacking as Artistic Practice",
   "subtitle": "!Mediengruppe Bitnik about their recent works",
   "slug": "30C3_-_5425_-_en_-_saal_6_-_201312281900_-_hacking_as_artistic_practice_-_mediengruppe_bitnik_-_mediengruppe_bitnik",
   "link": "http://events.ccc.de/congress/2013/Fahrplan/events/5425.html",
   "description": "!Mediengruppe Bitnik are contemporary artists. In their talk they will show two examples of their work, illustrating the translation of hacking from the computer field into an artistic practice. Bitnik will show how to hack the opera in ten easy steps and what happens when you send a parcel with a hidden live webcam to Julian Assange at the Ecuadorian Embassy in London. \n\nUsing the strategies of hacking, !Mediengrupppe Bitnik intervenes into settings with the aim of opening them up to re-evaluation and new perspectives.\n",
   "original_language": "eng",
   "persons": [
    "!Mediengruppe Bitnik",
    "!Mediengruppe Bitnik"
   ],
   "view_count": 339,
   "promoted": false,
   "date": "2013-12-28T01:00:00.000+01:00",
