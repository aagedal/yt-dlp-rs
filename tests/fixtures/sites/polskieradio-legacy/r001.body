<script>
  (function () {
    /**
     * Panel OneTrust otwierany z footera — SDK musi być w <head> strony hostującej:
     * <script src="https://cdn.cookielaw.org/scripttemplates/otSDKStub.js"
     *   data-domain-script="862184ff-e0e1-47d2-9fb1-c74d168817fc"><\/script>
     * <script>function OptanonWrapper() {}<\/script>
     */
    function tryOpenOneTrustPanel() {
      if (
        window.OneTrust &&
        typeof window.OneTrust.ToggleInfoDisplay === "function"
      ) {
        window.OneTrust.ToggleInfoDisplay();
        return true;
      }
      return false;
    }

    document.addEventListener("click", function (event) {
      var button = event.target.closest("[data-cmp-settings-button]");
      if (!button) return;
      event.preventDefault();
      if (!tryOpenOneTrustPanel()) {
        console.warn(
          "[Footer] OneTrust nie jest dostępny — dołącz otSDKStub.js w <head> strony hostującej."
        );
      }
    });

    // Fallback dla starych linków z ?cmpscreen — poll co 200 ms, max ~10 s
    if (/[?&]cmpscreen(?:=|$|&)/.test(window.location.search)) {
      var attempts = 0;
      var timer = setInterval(function () {
        if (tryOpenOneTrustPanel() || ++attempts >= 50) {
          clearInterval(timer);
        }
      }, 200);
    }
  })();
</script>


