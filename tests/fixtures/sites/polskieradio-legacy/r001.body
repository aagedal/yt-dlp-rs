    <meta property="og:title" content="Żagaryści. Poezja jak spoiwo"/>
<meta property="og:type" content="article"/>
<meta property="og:url" content="https://www.polskieradio.pl/8/2382/artykul/2534482,zagarysci-poezja-jak-spoiwo"/>
<meta property="og:site_name" content="PolskieRadio.pl"/>
<meta property="og:description" content="- Mamy do czynienia z wyraźnym fenomenem. Jest to grupa o charakterze partnerskim. I mimo że byli to studenci różnych kierunków, stała się grupą towarzyską, która stworzyła swój własny styl pisarski - mówił w Dwójce&#160;prof. Tadeusz Bujnicki, historyk literatury z Uniwersytetu Jagiellońskiego."/>
<meta property="og:image" content="https://static.prsa.pl/images/04216613-f7ed-4b3a-b7c8-3af5b235f049.jpg"/>
<meta property="twitter:card" content="summary_large_image"/>
<meta property="twitter:site" content="@PolskieRadiopl1"/>
<meta name="description" content="-&#32;Mamy&#32;do&#32;czynienia&#32;z&#32;wyraźnym&#32;fenomenem.&#32;Jest&#32;to&#32;grupa&#32;o&#32;charakterze&#32;partnerskim.&#32;I&#32;mimo&#32;że&#32;byli&#32;to&#32;studenci&#32;różnych&#32;kierunków,&#32;stała&#32;się&#32;grupą&#32;towarzyską,&#32;która&#32;stworzyła&#32;swój&#32;własny&#32;styl&#32;pisarski&#32;-&#32;mówił&#32;w&#32;Dwójce&#160;prof.&#32;Tadeusz&#32;Bujnicki,&#32;historyk&#32;literatury&#32;z&#32;Uniwersytetu&#32;Jagiellońskiego." /><link href="https://www.polskieradio.pl/8/2382/artykul/2534482,zagarysci-poezja-jak-spoiwo" rel="canonical" /></head>
    
