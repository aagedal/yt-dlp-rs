{"programs": [{"programId": "RC-025704", "title": "DJ Mehdi - Made in France", "shortDescription": "Mehdi Favéris-Essadi, better known by his stage name DJ Mehdi, was a key figure in the emerging French rap and electro scenes in the 2000s. Thirteen years after his untimely death, director and close friend Thibaut de Longeville sheds light on a pioneering artist. Lauded as a genius by many international musicians, DJ Mehdi is still relatively unknown outside of his native France. This six-part documentary aims to change that by telling his story.", "children": [{"programId": "119468-002-A", "catalogType": null}, {"programId": "119468-003-A", "catalogType": null}, {"programId": "119468-004-A", "catalogType": null}, {"programId": "119468-006-A", "catalogType": null}, {"programId": "119468-001-A", "catalogType": null}, {"programId": "119468-005-A", "catalogType": null}, {"programId": "PNF1406", "catalogType": null}, {"programId": "PNF1407", "catalogType": null}, {"programId": "PCF0110", "catalogType": null}, {"programId": "PCE0001", "catalogType": null}, {"programId": "PNA2132", "catalogType": null}, {"programId": "PNE0266", "catalogType": null}, {"programId": "PNI0266", "catalogType": null}, {"programId": "PNP0266", "catalogType": null}, {"programId": "PNS0266", "catalogType": null}, {"programId": "PNR0314", "catalogType": null}], "videos": [{"kind": "SHOW", "url": "https://www.arte.tv/en/videos/119468-001-A/dj-mehdi-made-in-france-1-6/", "programId": "119468-001-A"}, {"kind": "SHOW", "url": "https://www.arte.tv/en/videos/119468-002-A/dj-mehdi-made-in-france-2-6/", "programId": "119468-002-A"}, {"kind": "SHOW", "url": "https://www.arte.tv/en/videos/119468-003-A/dj-mehdi-made-in-france-3-6/", "programId": "119468-003-A"}, {"kind": "SHOW", "url": "https://www.arte.tv/en/videos/119468-004-A/dj-mehdi-made-in-france-4-6/", "programId": "119468-004-A"}, {"kind": "SHOW", "url": "https://www.arte.tv/en/videos/119468-005-A/dj-mehdi-made-in-france-5-6/", "programId": "119468-005